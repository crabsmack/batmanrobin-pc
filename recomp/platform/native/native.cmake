# native.cmake - the native runner's own build (phase 5 P6: docs/phases/P5-port.md), included by
# recomp/CMakeLists.txt; game_runner(... NATIVE ...) calls native_runner.
#
# The executable is the hand C in the headers' native branch (its game library, passed as SOURCES:
# the C, its bridge without the engine's dispatch stubs, the flow runtime, the arena, the exporter,
# the platform's native backend), the native machine (platform/native: the frame-synchronous machine,
# the runner's main, the input script, the SDL host) and from the engine only what the platform
# keeps (P6): the video model, the Z80 core, the sound chips and their mixer, the snapshottable
# fiber the game runs on. No 68000 core, interpreter, scheduler, dispatch, generated code or
# emulated work RAM is compiled in; `dkit genesis recomp scan` reads its objects and link map.
set(NATIVE_DIR "${CMAKE_CURRENT_LIST_DIR}")

# The launcher (launcher.cpp, the front door): Dear ImGui v1.92.9b (external/imgui, MIT) on SDL2's
# renderer, and its two fonts (Karla, SIL OFL 1.1; Roboto Medium, Apache 2.0; external/fonts) built into
# the program as byte arrays, written here at configure time (launcher_fonts.h in the build's native/).
# All of it from the X-Men 2 port's platform/native (the same kit).
set(NATIVE_IMGUI "${NATIVE_DIR}/external/imgui")
set(NATIVE_FONTS_DIR "${CMAKE_BINARY_DIR}/native")
set(NATIVE_FONTS_H "${NATIVE_FONTS_DIR}/launcher_fonts.h")
set(NATIVE_FONTS_BODY "/* launcher_fonts.h - generated by platform/native/native.cmake from platform/native/external/fonts */\n#pragma once\n")
foreach(NATIVE_FONT "k_font_karla:Karla-Regular.ttf" "k_font_roboto:Roboto-Medium.ttf")
    string(REPLACE ":" ";" NATIVE_FONT "${NATIVE_FONT}")
    list(GET NATIVE_FONT 0 NATIVE_FONT_VAR)
    list(GET NATIVE_FONT 1 NATIVE_FONT_FILE)
    set(NATIVE_FONT_PATH "${NATIVE_DIR}/external/fonts/${NATIVE_FONT_FILE}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${NATIVE_FONT_PATH}")
    file(READ "${NATIVE_FONT_PATH}" NATIVE_FONT_HEX HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])" "\\1\n" NATIVE_FONT_HEX "${NATIVE_FONT_HEX}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," NATIVE_FONT_HEX "${NATIVE_FONT_HEX}")
    string(APPEND NATIVE_FONTS_BODY "static const unsigned char ${NATIVE_FONT_VAR}[] = {\n${NATIVE_FONT_HEX}};\n")
endforeach()
file(CONFIGURE OUTPUT "${NATIVE_FONTS_H}" CONTENT "${NATIVE_FONTS_BODY}" @ONLY)

function(native_runner TARGET)
    cmake_parse_arguments(NR "" "" "SOURCES;DEFS" ${ARGN})
    add_executable(${TARGET} ${NR_SOURCES}
        "${NATIVE_DIR}/machine.cpp"
        "${NATIVE_DIR}/sound2.cpp"
        "${NATIVE_DIR}/runner.cpp"
        "${NATIVE_DIR}/state.cpp"
        "${NATIVE_DIR}/rewind.cpp"
        "${NATIVE_DIR}/options.cpp"
        "${NATIVE_DIR}/enhance.cpp"
        "${NATIVE_DIR}/spr_host.cpp"
        "${NATIVE_DIR}/present.cpp"
        "${NATIVE_DIR}/widescreen.cpp"
        "${NATIVE_DIR}/ws_draw.cpp"
        "${NATIVE_DIR}/input_script.cpp"
        "${NATIVE_DIR}/host_sdl.cpp"
        "${NATIVE_DIR}/shader.cpp"
        "${NATIVE_DIR}/controls.cpp"
        "${NATIVE_DIR}/launcher.cpp"
        # the launcher's UI: Dear ImGui (vendored, MIT) on SDL2's renderer
        "${NATIVE_IMGUI}/imgui.cpp"
        "${NATIVE_IMGUI}/imgui_draw.cpp"
        "${NATIVE_IMGUI}/imgui_tables.cpp"
        "${NATIVE_IMGUI}/imgui_widgets.cpp"
        "${NATIVE_IMGUI}/backends/imgui_impl_sdl2.cpp"
        "${NATIVE_IMGUI}/backends/imgui_impl_sdlrenderer2.cpp"
        "${NATIVE_DIR}/crash_report.cpp"
        "${NATIVE_DIR}/capture.cpp"
        "${CMAKE_SOURCE_DIR}/game/runtime/crash_win.cpp"
        "${RUNNER_ROOT}/fiber_compat.c"
        "${RUNNER_ROOT}/video/genesis_vdp.c"
        "${RUNNER_ROOT}/external/superzazu/z80.c"
        # the sound chips and their mixer (played runs; a headless run empties the queue each frame)
        "${RUNNER_ROOT}/audio.c"
        "${RUNNER_ROOT}/chip_trace.c"
        "${RUNNER_ROOT}/audio/event_queue.c"
        "${RUNNER_ROOT}/audio/mixer.c"
        "${RUNNER_ROOT}/audio/sn76489.c"
        "${RUNNER_ROOT}/audio/ym2612_ymfm.cpp"
        "${RUNNER_ROOT}/audio/fm_shadow.cpp"
        "${RUNNER_ROOT}/audio/observability.c"
        "${RUNNER_ROOT}/audio/audio_shadow.c"
        "${RUNNER_ROOT}/external/ymfm/src/ymfm_opn.cpp"
        "${RUNNER_ROOT}/external/ymfm/src/ymfm_ssg.cpp"
        "${RUNNER_ROOT}/external/ymfm/src/ymfm_adpcm.cpp"
        "${RUNNER_ROOT}/external/ymfm/src/ymfm_pcm.cpp")
    target_compile_definitions(${TARGET} PRIVATE DK_NATIVE=1 GENESIS_GAME_VERSION="${PROJECT_VERSION}"
        GENESIS_BATCHED_PLANES=$<STREQUAL:${GENESIS_VDP_PLANE_IMPL},BATCHED> ${NR_DEFS})
    target_include_directories(${TARGET} PRIVATE ${GAME_INCLUDE_DIRS} "${CMAKE_SOURCE_DIR}/game/include"
                               "${CMAKE_SOURCE_DIR}/platform" "${NATIVE_DIR}" "${NATIVE_IMGUI}" "${NATIVE_IMGUI}/backends"
                               "${NATIVE_FONTS_DIR}")
    target_link_libraries(${TARGET} PRIVATE SDL2::SDL2main SDL2::SDL2)
    if(WIN32)
        target_link_libraries(${TARGET} PRIVATE comdlg32)   # host_sdl.cpp's ROM picker
    endif()
    if(MSVC)
        target_compile_options(${TARGET} PRIVATE /W3 /WX- /utf-8 /wd4102 /wd4996)
        # the game's fiber replaces the stack pointer without a shadow-stack switch (fiber_compat.h)
        target_link_options(${TARGET} PRIVATE "/CETCOMPAT:NO"
            "/MAP:$<TARGET_FILE_DIR:${TARGET}>/${TARGET}.map")
        add_custom_command(TARGET ${TARGET} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "${RUNNER_ROOT}/external/SDL2/SDL2-2.28.5/lib/x64/SDL2.dll" "$<TARGET_FILE_DIR:${TARGET}>"
            COMMENT "Copying SDL2.dll")
    else()
        target_compile_definitions(${TARGET} PRIVATE _GNU_SOURCE)
        # no shadow stacks (the fiber's switch), and page-by-page probes of big frames on its stack
        target_compile_options(${TARGET} PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:-fstack-clash-protection>")
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
            target_compile_options(${TARGET} PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:-fcf-protection=none>")
        endif()
        find_package(Threads REQUIRED)
        target_link_libraries(${TARGET} PRIVATE Threads::Threads)
    endif()
    native_librashader(${TARGET})
endfunction()

# shader_preset (phase 6 R34, platform/native/shader.cpp): librashader's C headers are vendored (MIT,
# external/librashader, the v0.12.0 tag's include/ unmodified); the library itself (MPL-2.0) is loaded at
# run time from beside the program. Windows: librashader.dll, the upstream release unmodified, fetched once
# into the build tree by its SHA-256 (pinned for the package's ROM scan: docs/phases/P5-port.md "Third-party
# files"). Linux: librashader.so, built from the same release's source by tools/librashader_linux.py
# (upstream publishes no Linux library) into a per-version cache, copied from there; the program's RUNPATH
# ($ORIGIN) lets dlopen find it beside the program. Without it (offline, no cargo, BR_LIBRASHADER off) the
# build goes on and the option says the library is missing. From the X-Men 2 port's native.cmake.
option(BR_LIBRASHADER "librashader beside the program, for shader_preset" ON)
set(BR_LS_VER "0.12.0")
function(native_librashader TARGET)
    if(UNIX AND NOT APPLE)
        target_link_libraries(${TARGET} PRIVATE ${CMAKE_DL_LIBS})   # dlopen (librashader_ld.h)
        set_target_properties(${TARGET} PROPERTIES BUILD_RPATH "$ORIGIN" INSTALL_RPATH "$ORIGIN")
    endif()
    if(NOT BR_LIBRASHADER)
        return()
    endif()
    if(UNIX AND NOT APPLE)
        if(DEFINED ENV{BR_LIBRASHADER_CACHE})
            set(LS_SO "$ENV{BR_LIBRASHADER_CACHE}/librashader.so")
        else()
            set(LS_SO "$ENV{HOME}/.cache/batmanrobin/librashader-${BR_LS_VER}/librashader.so")
        endif()
        set(LS_SCRIPT "${CMAKE_SOURCE_DIR}/../tools/librashader_linux.py")
        if(NOT EXISTS "${LS_SO}" AND EXISTS "${LS_SCRIPT}")
            find_package(Python3 COMPONENTS Interpreter QUIET)
            if(Python3_Interpreter_FOUND)
                message(STATUS "librashader.so: building it once from the v${BR_LS_VER} source (minutes; tools/librashader_linux.py)")
                execute_process(COMMAND "${Python3_EXECUTABLE}" "${LS_SCRIPT}" RESULT_VARIABLE LS_RC)
            endif()
        endif()
        if(EXISTS "${LS_SO}")
            add_custom_command(TARGET ${TARGET} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different "${LS_SO}" "$<TARGET_FILE_DIR:${TARGET}>/librashader.so"
                COMMENT "Copying librashader.so")
        else()
            message(WARNING "no ${LS_SO} (python3 tools/librashader_linux.py builds it): shader_preset will say the library is missing")
        endif()
    endif()
    if(WIN32)
        set(LS_ZIP "${CMAKE_BINARY_DIR}/_deps/librashader-x86_64-windows-v${BR_LS_VER}-optimized.zip")
        set(LS_DIR "${CMAKE_BINARY_DIR}/_deps/librashader-${BR_LS_VER}")
        if(NOT EXISTS "${LS_DIR}/librashader.dll")
            file(DOWNLOAD
                "https://github.com/SnowflakePowered/librashader/releases/download/librashader-v${BR_LS_VER}/librashader-x86_64-windows-v${BR_LS_VER}-optimized.zip"
                "${LS_ZIP}"
                EXPECTED_HASH SHA256=521fe0f364bfa705883f9e99fb1733a3a24f0f403bcc5591b6b78f6cff289183
                STATUS LS_STATUS)
            list(GET LS_STATUS 0 LS_RC)
            if(LS_RC EQUAL 0)
                file(ARCHIVE_EXTRACT INPUT "${LS_ZIP}" DESTINATION "${LS_DIR}" PATTERNS "librashader.dll")
                file(REMOVE "${LS_ZIP}")
            else()
                message(WARNING "librashader ${BR_LS_VER} not fetched (${LS_STATUS}): shader_preset will say the library is missing")
            endif()
        endif()
        if(EXISTS "${LS_DIR}/librashader.dll")
            add_custom_command(TARGET ${TARGET} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different "${LS_DIR}/librashader.dll" "$<TARGET_FILE_DIR:${TARGET}>"
                COMMENT "Copying librashader.dll")
        endif()
    endif()
endfunction()
